{"id": "probe-01", "split": "probe", "text": "Kindly refund order #2020 — the ceiling is $75.", "constraints": [{"action": "refund", "resource": "order", "subject": "order:2020", "max": "75", "min": null, "unit": "USD", "authority": "none", "expiry": null}]}
