# ConstraintLens configuration (ARCHITECTURE.md §18). Copy to .env for local use.

# Service
CL_HOST=0.0.0.0
CL_PORT=8000
CL_LOG_LEVEL=INFO

# Storage / transport
CL_DB_URL=sqlite:///./data/constraintlens.db
CL_REDIS_URL=redis://localhost:6379/0

# Checker thresholds (starting points; final values come from tuning on the val split)
CL_THETA_LOW=0.35
CL_THETA_HIGH=0.80
CL_DELTA_MIN=0.15
CL_DWELL_THRESHOLD_S=300
CL_DEFAULT_MAX_AGE_S=3600

# Async boundary (ADR 0006): gap hold, publish-never-consumed timeout, sweeper period (0 = off)
CL_JOIN_TIMEOUT_S=60
CL_CONSUME_TIMEOUT_S=900
CL_SWEEP_INTERVAL_S=30

# Tiers
CL_ENABLE_TIER_1C=true
CL_ENABLE_TIER_2=true
CL_NLI_MODEL=
CL_EMBED_MODEL=

# Judge (provider-agnostic): anthropic | openai_compat
CL_JUDGE_PROVIDER=anthropic
CL_JUDGE_MODEL=
CL_JUDGE_API_KEY=
CL_JUDGE_TIMEOUT_S=10
CL_JUDGE_CACHE=true
CL_JUDGE_PROMPT_VERSION=v1

# Constraint extraction (ADR 0003): off | fallback | always
CL_EXTRACTION_LLM_MODE=fallback

# Failure policy and enforcement
CL_FAIL_HIGH_RISK=closed
CL_FAIL_LOW_RISK=open
CL_MAX_REGROUNDS=2
CL_ESCALATE_APPROVALS=false

# API protection (empty key = auth off, local development only)
CL_API_KEY=
CL_MAX_REQUEST_BYTES=1000000

# Privacy
CL_STORE_FULL_TEXT=false
CL_REDACT_PATTERNS=email,card,phone
